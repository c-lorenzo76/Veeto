# Google Places API (Server-only, never expose to client)
SECRET_KEY=your_google_places_api_key

# CORS origin (client URL, for Socket.io and CORS headers)
# Default: http://localhost:5173 (local dev)
# Production examples:
#   Dev1: https://veto-dev1.azurestaticapps.net
#   Dev: https://veto-dev.azurestaticapps.net
#   UAT: https://veto-uat.azurestaticapps.net
#   Prod: https://your-custom-domain.com
CLIENT_ORIGIN=http://localhost:5173

# Node environment
# Options: development, production
NODE_ENV=development
